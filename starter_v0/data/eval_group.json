      "metadata": {
        "skill": "multiturn_timeline_carry_limit",
        "difficulty": "medium",
        "what_it_tests": "Lượt 1 yêu cầu limit=3, lượt 2 cung cấp screenname zuck -> gọi timeline."
      }
    },
    {
      "id": "G08_multi_fetch_article",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tôi muốn đọc nội dung một bài báo khoa học."
