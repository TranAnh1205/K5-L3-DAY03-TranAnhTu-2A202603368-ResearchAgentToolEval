      "metadata": {
        "skill": "multiturn_fetch_provided_url",
        "difficulty": "medium",
        "what_it_tests": "Bổ sung URL ở lượt 2 -> gọi fetch chính xác địa chỉ đó."
      }
    },
    {
      "id": "G09_multi_confirm_send",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Gửi bản tin AI mới nhất lên Telegram"
        },
        {
          "role": "user",
          "content": "Tôi đã kiểm tra kỹ và xác nhận, hãy gửi ngay đi."
