{
  "dataset_id": "day04_v2_research_group",
  "dataset_role": "group",
  "description": "10 ca kiểm thử của nhóm (5 single-turn, 5 multi-turn) đo ranh giới tool mới, clarify và out of scope.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_calculator_basic",
      "phase": "B",
      "suite": "group",
      "query": "Tính giúp tôi 125 * 34",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "calculator",
            "args": {
              "expression": "125 * 34"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_calculator",
        "difficulty": "easy",
        "what_it_tests": "Phép tính số học trực tiếp -> route chính xác vào tool calculator."
      }
    },
    {
      "id": "G02_calculator_sqrt",
      "phase": "B",
      "suite": "group",
      "query": "Căn bậc hai của 256 cộng 44 bằng bao nhiêu",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "calculator",
            "args": {
              "expression": "sqrt(256) + 44"
            }
          }
        ]
      },
      "metadata": {
        "skill": "calculator_math_function",
        "difficulty": "medium",
        "what_it_tests": "Biểu thức toán có hàm sqrt -> route calculator với expression hợp lệ."
      }
    },
    {
      "id": "G03_lookup_vietnam_economy",
      "phase": "B",
      "suite": "group",
      "query": "Tìm kiếm tin tức kinh tế Việt Nam tuần này",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup",
            "args": {
              "query": "kinh tế Việt Nam",
              "topic": "news",
              "timeframe": "week"
            }
          }
        ]
      },
      "metadata": {
        "skill": "lookup_news_timeframe",
        "difficulty": "medium",
        "what_it_tests": "Tin tức tuần này -> topic=news và timeframe=week."
      }
    },
    {
      "id": "G04_missing_url_clarify",
      "phase": "B",
      "suite": "group",
      "query": "Đọc tóm tắt bài viết này giúp tôi với",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {}
          }
        ]
      },
      "metadata": {
        "skill": "clarify_missing_url",
        "difficulty": "medium",
        "what_it_tests": "Người dùng không cung cấp URL -> Bắt buộc gọi clarify thay vì fetch."
      }
    },
    {
      "id": "G05_out_of_scope_cooking",
      "phase": "B",
      "suite": "group",
      "query": "Hướng dẫn tôi cách nấu phở bò Hà Nội chuẩn vị",
      "failure_type": "out_of_scope",
      "expect": {
        "no_tool": true
      },
      "metadata": {
        "skill": "out_of_scope_rejection",
        "difficulty": "easy",
        "what_it_tests": "Câu hỏi nấu ăn ngoài phạm vi công cụ nghiên cứu -> Không gọi tool."
      }
    },
    {
      "id": "G06_multi_calculator",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tôi có 1200 quả táo, vừa bán đi 35% số táo."
        },
        {
          "role": "user",
          "content": "Tính giúp tôi số quả táo còn lại."
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "calculator",
            "args": {
              "expression": "1200 * 0.65"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_calculator_reasoning",
        "difficulty": "hard",
        "what_it_tests": "Ngữ cảnh 2 lượt tính toán tỷ lệ -> Gọi calculator với biểu thức phù hợp."
      }
    },
    {
      "id": "G07_multi_timeline_clarify_fill",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
